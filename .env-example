APP_NAME="Social Media Marketing Automation"
DATABASE_URL="postgresql+psycopg2://username:password@host:5432/dbname"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your_supabase_anon_or_service_key"

# JWT Configuration
SECRET_KEY="your_strong_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
API_V1_STR="/api"
PUBLIC_BASE_URL="https://your-backend-domain.vercel.app"
INSTAGRAM_REDIRECT_URI="https://your-backend-domain.vercel.app/api/credentials/instagram/callback"

# Fernet key used to encrypt credentials for wordpress, blogger, wix only.
# Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY="your_fernet_key_here"

# Meta / Instagram OAuth (used by GET /api/credentials/instagram/connect)
INSTAGRAM_CLIENT_ID="your_meta_app_id"
INSTAGRAM_CLIENT_SECRET="your_meta_app_secret"

# Blogger OAuth (used by GET /api/credentials/blogger/connect)
GOOGLE_REDIRECT_URI="https://your-backend-domain.vercel.app/api/credentials/blogger/callback"
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# Wix OAuth (used by GET /api/credentials/wix/connect)
WIX_REDIRECT_URI="https://your-backend-domain.vercel.app/api/credentials/wix/callback"
WIX_APP_ID="your_wix_app_id"
WIX_APP_SECRET="your_wix_app_secret"
# shareUrlId from the app's share-install link (external install flow, required
# for unlisted apps). Open the share link and copy its location UUID
# (https://wix.com/app-market/install/<shareUrlId>).
WIX_SHARE_URL_ID="your_wix_share_url_id"

# Super Admin Credentials
SUPERADMIN_EMAIL="superadmin@example.com"
SUPERADMIN_PASSWORD="YourStrongPassword123"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Gemini Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
